# .env.example — 복사해서 .env 로 저장 후 값 채우기 (절대 커밋하지 말 것)

# 이메일 (Gmail 앱 비밀번호: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
# 값에 공백이 있으면 반드시 따옴표로 감쌀 것
AIRADAR_SMTP_USER="your@gmail.com"
AIRADAR_SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
AIRADAR_EMAIL_TO="your@gmail.com"

# X API (developer.x.com → Free 플랜, Read+Write 권한)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Threads API (developers.facebook.com → Threads API 앱)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Bluesky (bsky.app → 설정 → 앱 비밀번호, 무료)
BSKY_HANDLE=you.bsky.social
BSKY_APP_PASSWORD=

# Mastodon (인스턴스 → 개발 → 앱 생성, 무료)
MASTO_ACCESS_TOKEN=

# LLM 한줄 해설 (선택 — 둘 중 하나만)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # 로컬/대체 엔드포인트 쓸 때
# OPENAI_MODEL=
